# ========================================================
# CẤU HÌNH DUY NHẤT CỦA DỰ ÁN (docker compose + heal.sh + systemd cùng đọc file này)
#   cp .env.example .env   rồi điền giá trị thật
# TUYỆT ĐỐI KHÔNG COMMIT .env LÊN GIT (đã nằm trong .gitignore)
# ========================================================

# 1. Telegram Bot (lấy từ @BotFather và @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Tài khoản quản trị Grafana (bắt buộc đặt mật khẩu riêng)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 3. Tầng 1 - heal.sh (watchdog trên host) và Circuit Breaker
#    Thời gian phát hiện ≈ (FAIL_THRESHOLD - 1) x CHECK_INTERVAL + độ lệch
FAIL_THRESHOLD=3
CHECK_INTERVAL=5
MAX_RESTARTS=3
# Ngưỡng cảnh báo CPU/RAM nằm trong prometheus/alert_rules.yml (đổi bằng scripts/alert_config.sh)
